{
  "schema_version": 3,
  "cookbook_id": "undressing.single_shot",
  "version": "0.11.0",
  "display_name": "MiniMax H3 Ref2V — continuité physique",
  "description": "Conserve le format compact et le protocole caméra H3, filtre la seconde référence sur l’apparence stable et explicite la continuité des objets, des prises et des ouvertures.",
  "target_mode": "ref2va",
  "output_contract": "minimax.h3.ref2v.single_shot_supervised_compact_h3_v1",
  "preset": "undressing-single-shot-physical-continuity-h3-v1",
  "stages": ["beat_sheet", "final_prompt"],
  "require_distinct_references": true,
  "invalid_camera_target_policy": "drop_with_warning",
  "sources": [
    "https://github.com/MiniMax-AI/MiniMax-H3/blob/05d91ff89f58b665e56424fd66db9ef0351b3015/skills/h3-prompt-writing/SKILL.md",
    "https://github.com/MiniMax-AI/MiniMax-H3/blob/05d91ff89f58b665e56424fd66db9ef0351b3015/skills/h3-prompt-writing/references/ref-en.txt",
    "https://www.reddit.com/r/unstable_diffusion/comments/1vjhr9b/pretty_good_undressing_with_minimax_writeup/",
    "https://www.reddit.com/r/DegenDiffusion/comments/1vfg8y7/sharing_prompts_for_minimax_h3/"
  ],
  "engine_contract": {
    "id": "minimax.h3.protocol",
    "version": "0.1.0"
  },
  "slots": [
    {
      "id": "dressed_start",
      "label": "Première frame habillée",
      "description": "Image exacte à 0,00 seconde : identité, vêtements, pose, composition et décor de départ.",
      "evidence_policy": "full",
      "subject_label": null,
      "accepted_uses": ["first_frame", "subject"],
      "required_uses": ["first_frame", "subject"],
      "required_shots": [1],
      "minimum_references": 1,
      "maximum_references": 1
    },
    {
      "id": "body_reference",
      "label": "Référence corporelle",
      "description": "Référence d'apparence stable du même sujet ; sa pose, sa tenue, sa caméra, sa lumière et son décor sont exclus.",
      "evidence_policy": "appearance_only_v1",
      "subject_label": null,
      "accepted_uses": ["subject"],
      "required_uses": ["subject"],
      "required_shots": [1],
      "minimum_references": 1,
      "maximum_references": 1
    }
  ],
  "templates": {
    "beat_sheet_system": "action_plan.system.txt",
    "beat_sheet_user": "action_plan.user.txt",
    "beat_sheet_reconcile_system": "action_plan_reconcile.system.txt",
    "beat_sheet_reconcile_user": "action_plan_reconcile.user.txt",
    "final_prompt_system": "final_prompt.system.txt",
    "final_prompt_user": "final_prompt.user.txt",
    "revision_system": "revision.system.txt",
    "revision_user": "revision.user.txt"
  }
